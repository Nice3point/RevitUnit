<Project>

    <!-- Global NuGet configuration -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Revit dependencies -->
    <ItemGroup>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*-*" Condition="$(RevitVersion) != ''"/>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*-*" Condition="$(RevitVersion) != ''"/>

        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2021.4.3" Condition="$(RevitVersion) == '2021'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2022.4.3" Condition="$(RevitVersion) == '2022'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2023.4.3" Condition="$(RevitVersion) == '2023'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2024.3.3" Condition="$(RevitVersion) == '2024'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2025.2.3" Condition="$(RevitVersion) == '2025'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2026.1.3" Condition="$(RevitVersion) == '2026'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2027.0.3" Condition="$(RevitVersion) == '2027'"/>

        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2021.5.6" Condition="$(RevitVersion) == '2021'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2022.5.6" Condition="$(RevitVersion) == '2022'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2023.5.6" Condition="$(RevitVersion) == '2023'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2024.3.6" Condition="$(RevitVersion) == '2024'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2025.2.6" Condition="$(RevitVersion) == '2025'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2026.1.6" Condition="$(RevitVersion) == '2026'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2027.0.6" Condition="$(RevitVersion) == '2027'"/>

        <PackageVersion Include="Nice3point.Revit.Injector" Version="2021.1.13" Condition="$(RevitVersion) == '2021'"/>
        <PackageVersion Include="Nice3point.Revit.Injector" Version="2022.1.13" Condition="$(RevitVersion) == '2022'"/>
        <PackageVersion Include="Nice3point.Revit.Injector" Version="2023.1.13" Condition="$(RevitVersion) == '2023'"/>
        <PackageVersion Include="Nice3point.Revit.Injector" Version="2024.1.13" Condition="$(RevitVersion) == '2024'"/>
        <PackageVersion Include="Nice3point.Revit.Injector" Version="2025.1.13" Condition="$(RevitVersion) == '2025'"/>
        <PackageVersion Include="Nice3point.Revit.Injector" Version="2026.1.13" Condition="$(RevitVersion) == '2026'"/>
        <PackageVersion Include="Nice3point.Revit.Injector" Version="2027.0.13" Condition="$(RevitVersion) == '2027'"/>
    </ItemGroup>

    <!-- Core dependencies -->
    <ItemGroup>
        <PackageVersion Include="PolyHook2.NET" Version="1.1.9"/>

        <!-- Build automation -->
        <PackageVersion Include="Sourcy.DotNet" Version="1.1.1"/>
        <PackageVersion Include="ModularPipelines" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.Git" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.GitHub" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8"/>
        <PackageVersion Include="ILRepack" Version="2.0.48"/>

        <!-- Testing -->
        <PackageVersion Include="TUnit" Version="1.78.0"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>

        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52"/>

        <!-- System dependencies -->
        <PackageVersion Include="System.Memory" Version="4.6.3" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"/>
        <PackageVersion Include="System.Text.Json" Version="10.0.12" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"/>
    </ItemGroup>

    <!-- Development dependencies -->
    <ItemGroup>
        <GlobalPackageReference Include="Polyfill" Version="11.4.5"/>
        <GlobalPackageReference Include="JetBrains.Annotations.Sources" Version="2026.2.0"/>
    </ItemGroup>

</Project>
